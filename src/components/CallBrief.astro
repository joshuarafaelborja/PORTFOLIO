---
// "Call brief" concept card from the Loop case study (Figma 1028:386).
// https://www.figma.com/design/2nYhgPKrVIuNd9J4G02Mae/ai-app?node-id=1028-386
//
// Static, no JS. A company's onboarding answers on the left; an AI summary and a
// suggested opening question on the right. Two columns from 640px up (grid stretch,
// so both columns end at the same height), stacked below that.
//
// Type: Poppins for all text, Anton for the two panel headings only. Minimum 16px.
// Fonts are loaded by the Loop page (src/styles/loop-fonts.css); these fall back
// cleanly elsewhere. The heavy bottom/right edges are decorative CSS borders.
import { Image } from "astro:assets";
import wordmark from "../assets/work/loop/wordmark-primary.svg";

export interface CallBriefData {
	pill: string;
	answersHeading: string;
	answers: { label: string; value: string }[];
	summary: { heading: string; body: string };
	suggestion: { heading: string; body: string };
}

interface Props extends CallBriefData {
	/** Accessible name for the card. */
	label?: string;
	class?: string;
}

const { label = "Call brief concept", pill, answersHeading, answers, summary, suggestion, class: className } = Astro.props;
---

<section aria-label={label} class:list={["call-brief flex w-full min-w-0 flex-col gap-4 bg-white p-4 sm:p-6", className]}>
	<p class="flex justify-end">
		<span class="cb-pill">{pill}</span>
	</p>

	<div class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:gap-6">
		<div class="flex min-w-0 flex-col gap-6">
			<Image src={wordmark} alt="Loop" class="h-auto w-[72px]" />
			<div class="flex flex-col gap-2">
				<h3 class="cb-answers-heading">{answersHeading}</h3>
				<dl class="cb-text flex flex-col">
					{
						answers.map((a) => (
							<div class="cb-row flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
								<dt>{a.label}</dt>
								<dd class="font-semibold">{a.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>

		<div class="flex min-w-0 flex-col gap-3">
			<div class="cb-panel cb-panel-summary flex-1">
				<h3 class="cb-panel-heading">{summary.heading}</h3>
				<p class="cb-text">{summary.body}</p>
			</div>
			<div class="cb-panel cb-panel-suggestion">
				<h3 class="cb-panel-heading">{suggestion.heading}</h3>
				<p class="cb-text">{suggestion.body}</p>
			</div>
		</div>
	</div>
</section>

<style>
	/* Royale (#145DD7) card with the heavy bottom/right edge from Figma. */
	.call-brief {
		border: solid #145dd7;
		border-width: 4px 12px 12px 4px;
		border-radius: 12px;
	}

	.cb-text,
	.cb-pill,
	.cb-answers-heading {
		font-family: var(--loop-font-text, "Poppins", system-ui, sans-serif);
		font-size: 16px;
		line-height: 1.5;
		color: #070707;
	}
	.cb-answers-heading {
		font-size: 20px;
		font-weight: 600;
		line-height: normal;
		color: #145dd7;
	}

	/* Answer rows: 2px Powder dividers. */
	.cb-row {
		border-bottom: 2px solid #b0dcff;
	}

	.cb-pill {
		display: inline-block;
		padding: 4px 16px;
		border: 2px solid #070707;
		border-radius: 999px;
		background-color: #b0dcff;
		line-height: normal;
	}

	/* Panels: 4px top/left, 8px bottom/right, 12px radius (Figma 1028:423 / 1028:436). */
	.cb-panel {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 12px 16px 16px;
		border: solid;
		border-width: 4px 8px 8px 4px;
		border-radius: 12px;
	}
	@media (min-width: 640px) {
		.cb-panel {
			padding: 12px 24px 16px;
		}
	}
	.cb-panel-summary {
		background-color: #b0dcff;
		border-color: #145dd7;
	}
	.cb-panel-suggestion {
		background-color: #cafe5b;
		border-color: #070707;
	}
	.cb-panel-heading {
		font-family: var(--loop-font-display, "Anton", Impact, sans-serif);
		font-size: 20px;
		font-weight: 400;
		line-height: normal;
		color: #070707;
	}
</style>
