---
// Coach section — rebuilt to match Figma frame "Desktop - 3" (node 724:401)
// https://www.figma.com/design/2nYhgPKrVIuNd9J4G02Mae/ai-app?node-id=724-84
const tags = "Lovable · Supabase · Claude API";
const year = "2026";
const description =
	"Coach is a solo-built fitness web app that integrates AI directly into warm-up calculations and progression planning, so lifters always know exactly what to do when they walk into the gym.";
---

<section class="flex flex-col gap-4 border-b border-[#d4d2cc] pb-8">
	<div class="flex flex-wrap items-center gap-1">
		<h2 class="font-space-grotesk text-2xl font-bold text-[#1a1a1a]">Coach</h2>
		<img src="/images/coach-icon.png" alt="" class="size-8 shrink-0 object-cover" />
		<p class="font-space-grotesk text-base text-[#1a1a1a] sm:w-[248px]">{tags}</p>
		<p class="font-space-grotesk text-base text-[#1a1a1a]">{year}</p>
	</div>

	<div class="flex w-full max-w-[916px] flex-col gap-3">
		<p class="font-space-grotesk text-base text-[#1a1a1a]">{description}</p>
	</div>

	<div class="flex w-full max-w-[916px] flex-col gap-3">
		<p class="font-space-grotesk text-base font-bold text-[#1a1a1a]">Try it live</p>
		<div class="flex justify-center overflow-x-auto py-2">
			<iframe
				src="https://coachtest.vercel.app"
				style="width: 390px; height: 844px; border-radius: 24px; border: none;"
				title="Coach live app"></iframe>
		</div>
	</div>
</section>
