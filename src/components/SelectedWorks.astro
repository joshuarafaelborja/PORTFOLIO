---
import loopHero from "../assets/work/loop/2026-10-29-loop-hero.png";

interface Work {
	title: string;
	tagline: string;
	img: string;
	imgAlt: string;
	years: string;
	href: string;
}

const works: Work[] = [
	{
		title: "Eduseek.AI",
		tagline: "PRODUCT DESIGN / AI UX / EDTECH",
		img: "/images/work/eduseek/hero-2x.png",
		imgAlt: "Eduseek.AI session replay dashboard",
		years: "2025 - 2026",
		href: "/work/eduseek",
	},
	{
		title: "Coach",
		tagline: "PRODUCT DESIGN / AI/ML / BUILDER",
		img: "/images/work/coach/hero-2x.png",
		imgAlt: "Coach mobile app calculator screen",
		years: "2024 - 2026",
		href: "/work/coach",
	},
	{
		title: "Loop",
		tagline: "PRODUCT DESIGN / B2B ONBOARDING / MOBILITY",
		img: loopHero.src,
		imgAlt: "Loop wordmark with the letter o repeated around it, suggesting a loop",
		years: "2025",
		href: "/work/loop",
	},
	{
		title: "Viable Community",
		tagline: "PRODUCT DESIGN / UX RESEARCH / E-COMMERCE",
		img: "/images/work/viable-community/hero-2x.png",
		imgAlt: "Viable Marketplace storefront homepage",
		years: "2025 - 2026",
		href: "/work/viable-community",
	},
];
---

<section class="flex flex-col gap-4 border-b border-[#d4d2cc] pb-8">
	<h2 class="font-space-grotesk text-2xl font-bold text-[#1a1a1a]"><span class="font-normal">2026 </span>&gt; Selected Works</h2>
	{
		works.map((work) => (
			<a href={work.href} class="card-hover flex w-full flex-col gap-3">
				<p class="font-space-grotesk text-base font-bold text-[#1a1a1a]">{work.title}</p>
				<p class="font-space-grotesk text-base text-[#1a1a1a]">{work.tagline}</p>
				<div class="card-hover-surface aspect-[960/540] w-full overflow-hidden bg-[#1a1a1a]">
					<img src={work.img} alt={work.imgAlt} class="h-full w-full object-cover" loading="lazy" />
				</div>
				<p class="font-space-grotesk text-base text-[#1a1a1a]">{work.years}</p>
			</a>
		))
	}
</section>
