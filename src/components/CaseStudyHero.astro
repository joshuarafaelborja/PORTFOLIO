---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface MetaItem {
	label: string;
	value: string;
}

interface Props {
	title: string;
	/** A public/ path, or an imported image (rendered with astro:assets at its own ratio). */
	heroSrc: ImageMetadata | string;
	heroAlt: string;
	/** Placeholder label used when heroSrc is empty ("Screenshot: <name>"). */
	heroPlaceholder?: string;
	meta: MetaItem[];
}

const { title, heroSrc, heroAlt, heroPlaceholder = "hero", meta } = Astro.props;
---

<section class="flex flex-col gap-4 border-b border-[#d4d2cc] pb-8">
	<h1 class="font-space-grotesk text-2xl font-bold text-[#1a1a1a]">{title}</h1>
	{
		typeof heroSrc === "object" ? (
			<Image
				src={heroSrc}
				alt={heroAlt}
				widths={[960, 1920]}
				sizes="(min-width: 1056px) 960px, 100vw"
				loading="eager"
				class="h-auto w-full rounded-[4px] border border-[#d4d2cc]"
			/>
		) : heroSrc ? (
			<div class="aspect-[960/479] w-full overflow-hidden rounded-[4px] border border-[#d4d2cc] bg-[#1a1a1a]">
				<img src={heroSrc} alt={heroAlt} class="h-full w-full object-cover" />
			</div>
		) : (
			<ImagePlaceholder src="" alt={heroAlt} name={heroPlaceholder} ratio={[960, 479]} />
		)
	}
	<div class="flex flex-wrap gap-4">
		{
			meta.map((item) => (
				<div class="flex flex-col gap-2">
					<p class="font-space-grotesk text-base text-[#1a1a1a]">{item.label}</p>
					<p class="font-space-grotesk text-base text-[#1a1a1a]">{item.value}</p>
				</div>
			))
		}
	</div>
</section>
