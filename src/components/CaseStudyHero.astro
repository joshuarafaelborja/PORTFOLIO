---
interface MetaItem {
	label: string;
	value: string;
}

interface Props {
	title: string;
	heroSrc: string;
	heroAlt: string;
	meta: MetaItem[];
}

const { title, heroSrc, heroAlt, meta } = Astro.props;
---

<section class="flex flex-col gap-4 border-b border-[#d4d2cc] pb-8">
	<h1 class="font-space-grotesk text-2xl font-bold text-[#1a1a1a]">{title}</h1>
	<div class="aspect-[960/479] w-full overflow-hidden rounded-[4px] bg-[#1a1a1a]">
		<img src={heroSrc} alt={heroAlt} class="h-full w-full object-cover" />
	</div>
	<div class="flex flex-wrap gap-4">
		{
			meta.map((item) => (
				<div class="flex flex-col gap-2">
					<p class="font-space-grotesk text-base text-[#1a1a1a]">{item.label}</p>
					<p class="font-space-grotesk text-base text-[#1a1a1a]">{item.value}</p>
				</div>
			))
		}
	</div>
</section>
