---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "Astro" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<main class="flex justify-center bg-[#e8e7e3] px-6 pt-[29px] pb-[25px] sm:px-10 lg:px-[96px]">
			<div class="flex w-full max-w-[960px] flex-col gap-8">
				<a
					href="/"
					class="link-hover w-fit font-serif text-4xl font-bold leading-normal text-[#4a4a4a] hover:text-[#1a1a1a]"
				>
					JB
				</a>
				<slot />
			</div>
		</main>
	</body>
</html>
