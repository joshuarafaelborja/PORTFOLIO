---
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";
import CaseStudyHero from "../components/CaseStudyHero.astro";

interface MetaItem {
	label: string;
	value: string;
}

interface Props {
	title: string;
	/** A public/ path, or an imported image (rendered with astro:assets). */
	heroSrc: ImageMetadata | string;
	heroAlt: string;
	meta: MetaItem[];
	/** Keep the page out of search results (drafts). */
	noindex?: boolean;
}

const { title, heroSrc, heroAlt, meta, noindex } = Astro.props;
---

<Layout title={`${title} — JB`} noindex={noindex}>
	<CaseStudyHero title={title} heroSrc={heroSrc} heroAlt={heroAlt} meta={meta} />
	<slot />
</Layout>
