---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="About Me | Josh Borja">
	<section class="flex flex-col gap-16">
		<h1 class="font-space-grotesk text-2xl font-bold text-[#1a1a1a]">Josh Borja</h1>
		<div class="flex flex-col gap-2">
			<h1 class="font-space-grotesk text-base font-bold text-[#1a1a1a]">HEY</h1>
			<p class="font-space-grotesk text-base text-[#1a1a1a]">
				Bashing my head against the problem. Solved through iteration.<br />
				In debt to video games and clothing. Pushing design further.<br />
				Built in the Bay Area.
			</p>
		</div>
		<div class="flex flex-col gap-2">
			<h2 class="font-space-grotesk text-base font-bold text-[#1a1a1a]">ABOUT ME</h2>
			<p class="font-space-grotesk text-base text-[#1a1a1a]">
				&gt; 5 years of barista experience.<br />
				&gt; Working various freelance product design jobs.<br />
				&gt; I enjoy playing old PlayStation 2 games.<br />
				&gt; When I'm designing, I get the same focus I get from sports and video games. I like working a problem until it clicks.
			</p>
		</div>
	</section>
	<Footer />
</Layout>
