---
// DRAFT: Loop case study. noindex, and not linked from the homepage, nav or Works page.
// Rebuilt from Figma "loop casestudy" frame (node 807:17)
// https://www.figma.com/design/2nYhgPKrVIuNd9J4G02Mae/ai-app?node-id=807-17
// All copy and image paths live in src/data/loop.ts.
import "../../styles/loop-fonts.css";
import { Image, getImage } from "astro:assets";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";
import TabSwitcher from "../../components/TabSwitcher.astro";
import ImagePlaceholder from "../../components/ImagePlaceholder.astro";
import CallBrief from "../../components/CallBrief.astro";
import OnboardingFlow from "../../components/OnboardingFlow.astro";
import StatStrip from "../../components/StatStrip.astro";
import Footer from "../../components/Footer.astro";
import {
	page,
	hero,
	meta,
	outcome,
	context,
	problem,
	solution,
	brand,
	ctas,
	onboarding,
	onboardingFlow,
	rebuild,
	reflection,
} from "../../data/loop";

// Poster as webp at the recording's full width (the source png is 1.2 MB).
const poster = (await getImage({ src: outcome.video.poster, format: "webp" })).src;

const text = "font-space-grotesk text-base text-[#1a1a1a]";
const bullets = "flex list-disc flex-col gap-1 pl-6 font-space-grotesk text-base text-[#1a1a1a]";
// Shared by the Problem and Tried / Noticed / Fix rows. Grid rows stretch, so pills in a
// row are the same height; content is top-anchored so the headings line up.
// The CTA exports (Figma 1052:435-438) are 24px-radius rectangles at 2x with a dark fill
// baked in outside the curve. Match that curve as a % of the image so it scales with it
// and clips the dark corners; +1px covers the border.
const ctaRadius = ({ width, height }: { width: number; height: number }) =>
	`border-radius: calc(${(4800 / width).toFixed(3)}% + 1px) / calc(${(4800 / height).toFixed(3)}% + 1px)`;
const pill = "loop-pill flex flex-col items-center justify-start gap-2 px-6 py-5 text-center";
const pillBody = "font-space-grotesk text-base leading-[1.4] text-[#1a1a1a]";
---

<CaseStudyLayout title={page.title} heroSrc={hero.src} heroAlt={hero.alt} meta={meta} noindex>
	<CaseStudySection eyebrow={outcome.eyebrow} heading={outcome.heading}>
		<!-- Landing page scroll recording. Autoplays muted on loop. The button only shows with
		     reduced motion (poster + Play/Pause) or when the video is paused, e.g. if the
		     browser blocks autoplay. -->
		<div class="relative w-full">
			<video
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster={poster}
				width={outcome.video.poster.width}
				height={outcome.video.poster.height}
				aria-label={outcome.video.label}
				class="block h-auto w-full rounded-[4px] border border-[#d4d2cc]"
			>
				<source src={outcome.video.src} type="video/mp4" />
			</video>
			<button
				type="button"
				hidden
				data-play={outcome.video.play}
				data-pause={outcome.video.pause}
				class="absolute bottom-3 left-3 rounded-[4px] bg-[#1a1a1a] px-3 py-1 font-space-grotesk text-base text-white focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#1a1a1a]"
			>
				{outcome.video.play}
			</button>
			<!-- Inline and right after the video, so it runs before autoplay starts. -->
			<script is:inline>
				(() => {
					const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
					const wrap = document.currentScript.parentElement;
					const video = wrap.querySelector("video");
					const button = wrap.querySelector("button");
					const sync = () => {
						button.hidden = !reduce && !video.paused;
						button.textContent = video.paused ? button.dataset.play : button.dataset.pause;
					};
					if (reduce) {
						video.autoplay = false;
						video.removeAttribute("autoplay");
						video.pause();
						sync();
					} else {
						// Autoplay blocked: leave it paused and offer Play.
						video.play().catch(sync);
					}
					video.addEventListener("play", sync);
					video.addEventListener("pause", sync);
					button.addEventListener("click", () => {
						if (video.paused) video.play();
						else video.pause();
					});
				})();
			</script>
		</div>
		<!-- Same strip and border as the EduSeek hero stats. -->
		<StatStrip stats={outcome.stats} class="border-y border-[#d4d2cc]" />
		<p class={text}>{outcome.body}</p>
	</CaseStudySection>

	<CaseStudySection eyebrow={context.eyebrow} heading={context.heading}>
		<p class={text}>{context.body}</p>
	</CaseStudySection>

	<CaseStudySection eyebrow={problem.eyebrow} heading={problem.heading}>
		<!-- Figma 987:191. Stacked below lg, three across from lg up. -->
		<ul class="grid w-full grid-cols-1 gap-4 lg:grid-cols-3">
			{
				problem.pills.map((p) => (
					<li class={pill}>
						<h3 class="loop-pill-heading">{p.heading}</h3>
						<p class={pillBody}>{p.body}</p>
					</li>
				))
			}
		</ul>
	</CaseStudySection>

	<CaseStudySection eyebrow={solution.eyebrow} heading={solution.heading}>
		<TabSwitcher label="Solutions" items={solution.tabs} variant="loop" />
	</CaseStudySection>

	<CaseStudySection eyebrow={brand.eyebrow} heading={brand.heading}>
		<p class={text}>{brand.body}</p>
		<!-- Wordmark versions (Figma 957:1707) + brand components image. Side by side from lg up,
		     ending at the same height (the right image has its shadow baked in; mb-2 matches it). -->
		<div class="flex w-full flex-col items-center gap-9 lg:flex-row lg:items-stretch">
			<div class="loop-card flex w-full items-center justify-center p-6 lg:mb-2 lg:flex-1">
				<Image src={brand.wordmarks.src} alt={brand.wordmarks.alt} class="h-auto w-full max-w-[480px]" />
			</div>
			<Image
				src={brand.card.src}
				alt={brand.card.alt}
				widths={[384, 768]}
				sizes="384px"
				class="h-auto w-full max-w-[384px] shrink-0"
			/>
		</div>
		<p class={text}>{brand.note}</p>
	</CaseStudySection>

	<CaseStudySection eyebrow={ctas.eyebrow} heading={ctas.heading}>
		<ul class={bullets}>
			{
				ctas.fixes.map((f) => (
					<li>
						<p><strong>{f.lead}</strong> {f.body}</p>
						<!-- Before/After side by side from 640px; flex-grow follows each image's aspect
						     ratio so both images end up the same height. -->
						<div class="mt-4 mb-4 flex flex-col gap-4 sm:flex-row">
							{[
								{ label: ctas.beforeLabel, img: f.before },
								{ label: ctas.afterLabel, img: f.after },
							].map(({ label, img }) => (
								<figure
									class="flex min-w-0 flex-col gap-2"
									style={`flex: ${img.src.width / img.src.height} 1 0%`}
								>
									<figcaption class="font-space-grotesk text-base text-[#1a1a1a]">{label}</figcaption>
									<Image
										src={img.src}
										alt={img.alt}
										widths={[img.src.width / 2, img.src.width]}
										sizes="(min-width: 1056px) 560px, 100vw"
										class="h-auto w-full border border-[#d4d2cc]"
										style={ctaRadius(img.src)}
									/>
								</figure>
							))}
						</div>
					</li>
				))
			}
		</ul>
	</CaseStudySection>

	<CaseStudySection eyebrow={onboarding.eyebrow} heading={onboarding.heading}>
		<!-- Figma 1047:154, restyled to match the Problem pills. Stacked below lg,
		     three across from lg up. -->
		<ul class="grid w-full grid-cols-1 gap-4 lg:grid-cols-3">
			{
				onboarding.pills.map((p) => (
					<li class={pill}>
						<h3 class="loop-pill-heading">{p.heading}</h3>
						<p class={pillBody}>{p.body}</p>
					</li>
				))
			}
		</ul>
		<figure class="flex w-full flex-col gap-2">
			<OnboardingFlow copy={onboardingFlow} />
			<figcaption class="font-space-grotesk text-base text-[#1a1a1a]">{onboarding.caption}</figcaption>
		</figure>
	</CaseStudySection>

	<CaseStudySection eyebrow={rebuild.eyebrow} heading={rebuild.heading}>
		<p class={text}>{rebuild.intro}</p>
		<ul class={bullets}>
			<li>
				<p><strong>{rebuild.accessibility.lead}</strong> {rebuild.accessibility.body}</p>
				<ImagePlaceholder
					src={rebuild.accessibility.image.src}
					alt={rebuild.accessibility.image.alt}
					name={rebuild.accessibility.image.placeholder}
					ratio={[16, 10]}
					class="mt-4 mb-4 border border-[#d4d2cc]"
				/>
			</li>
			<li>
				<p><strong>{rebuild.ai.lead}</strong> {rebuild.ai.body}</p>
				<CallBrief {...rebuild.callBrief} class="mt-4" />
			</li>
		</ul>
	</CaseStudySection>

	<CaseStudySection eyebrow={reflection.eyebrow} heading={reflection.heading}>
		<div class="flex flex-col gap-2">
			<ul class={bullets}>
				{
					reflection.bullets.map((b) =>
						typeof b === "string" ? (
							<li>{b}</li>
						) : (
							<li>
								<strong>{b.lead}</strong> {b.body}
							</li>
						),
					)
				}
			</ul>
			<p class={text}>{reflection.body}</p>
		</div>
	</CaseStudySection>

	<Footer />
</CaseStudyLayout>

<style>
	/* White card, Royale border and Royale offset shadow (Brand section). */
	.loop-card {
		background-color: #fff;
		border: 4px solid #145dd7;
		border-radius: 16px;
		box-shadow: 8px 8px 0 0 #145dd7;
	}
	/* Lime pill (Problem and Tried / Noticed / Fix rows): Energy fill, thin black
	   border, hard black offset shadow. Lighter take on Figma 986:164 / 1047:154. */
	.loop-pill {
		background-color: #d3ff6c;
		border: 2px solid #000;
		border-radius: 32px;
		box-shadow: 4px 4px 0 0 #000;
	}
	/* Heading font is one variable in src/styles/loop-fonts.css (--loop-pill-font).
	   Anton ships in one weight (400). */
	.loop-pill-heading {
		font-family: var(--loop-pill-font);
		font-size: 18px;
		font-weight: 400;
		line-height: normal;
		text-transform: uppercase;
		color: #070707;
	}
</style>
